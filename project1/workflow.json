      "parameters": {
        "jsCode": "const text = $json.output;\n\nconst match = text.match(/\\[BOOKING_CONFIRMED:\\s*name=(.*?),\\s*service=(.*?),\\s*date=(.*?),\\s*time=(.*?)\\]/);\n\nif (match) {\n  return [{\n    json: {\n      name: match[1].trim(),\n      service: match[2].trim(),\n      date: match[3].trim(),\n      time: match[4].trim(),\n      status: \"Confirmed\"\n    }\n  }];\n}\n\nreturn [{ json: { name: \"Unknown\", service: \"Unknown\", date: \"Unknown\", time: \"Unknown\", status: \"Confirmed\" } }];"
