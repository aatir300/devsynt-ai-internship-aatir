    {
      "parameters": {
        "jsCode": "const text = $('AI Agent').first().json.output;\nconst match = text.match(/\\[HANDOFF:\\s*reason=(.*?)\\]/);\nconst chatData = $('Telegram Trigger').first().json.message;\nconst name = chatData.from.first_name || \"Unknown\";\n\nif (match) {\n  return [{\n    json: {\n      name: name,\n      message: chatData.text,\n      reason: match[1].trim(),\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\nreturn [{ json: { name: name, message: chatData.text, reason: \"Unknown\", timestamp: new Date().toISOString() } }];"
      },
